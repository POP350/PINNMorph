# Copy this file to .env.local. Replace the example model IDs with models supported by your endpoints.
# .env.local is loaded as configuration, not executed by the shell.
DUAL_LLM_1_PROVIDER=openai_compatible
DUAL_LLM_1_MODEL=DeepSeek-V4-Flash
DUAL_LLM_1_API_KEY=
DUAL_LLM_1_API_BASE_URL=https://your-endpoint.example/v1

DUAL_LLM_2_PROVIDER=openai_compatible
DUAL_LLM_2_MODEL=Qwen3.8-27B
DUAL_LLM_2_API_KEY=
DUAL_LLM_2_API_BASE_URL=https://your-endpoint.example/v1

PINNMORPH_LLM_CONCURRENCY=3
